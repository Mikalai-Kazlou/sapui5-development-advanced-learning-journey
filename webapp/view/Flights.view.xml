<mvc:View
    controllerName="student.com.sap.training.advancedsapui5.listdetail.controller.Flights"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:l="sap.ui.layout"
    xmlns:ux="sap.uxap"
    xmlns="sap.m"
    displayBlock="true"
>
    <ux:ObjectPageLayout id="objectPageLayout">
        <ux:headerTitle>
            <ux:ObjectPageDynamicHeaderTitle id="objectPageDynamicHeader">
                <ux:expandedHeading>
                    <Title
                        id="fltitle"
                        text="{Carrname}"
                        level="H2"
                    />
                </ux:expandedHeading>
            </ux:ObjectPageDynamicHeaderTitle>
        </ux:headerTitle>

        <ux:headerContent>
            <FlexBox
                wrap="Wrap"
                id="flexBox"
            >
                <Avatar
                    id="avatar"
                    src="sap-icon://flight"
                />
                <l:VerticalLayout
                    id="verticalLayout1"
                    class="sapUiSmallMarginBeginEnd"
                >
                    <Label
                        id="label1"
                        text="{Carrid}"
                    />
                    <Label
                        id="label2"
                        text="{Url}"
                    />
                </l:VerticalLayout>
            </FlexBox>
        </ux:headerContent>

        <ux:sections>
            <ux:ObjectPageSection id="objectPageSection">
                <ux:ObjectPageSubSection id="objectPageSubSection1">
                    <Table
                        id="idFlights"
                        items="{path: 'to_Flight', sorter: {path: 'Carrid'}}"
                        mode="SingleSelectMaster"
                        growing="true"
                        growingThreshold="10"
                    >
                        [...]
                    </Table>
                </ux:ObjectPageSubSection>
            </ux:ObjectPageSection>
        </ux:sections>
    </ux:ObjectPageLayout>
</mvc:View>
